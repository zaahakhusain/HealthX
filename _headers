# Real HTTP security headers (Netlify / Cloudflare Pages format).
# Meta tags in the HTML cover CSP, but frame-ancestors, HSTS, nosniff and
# Permissions-Policy only work as response headers. If you host elsewhere
# (Vercel, Nginx, Apache), copy these same values into that host's config.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
